

{
    "manifest_version": 3,
    "name": "Phishing Detector",
    "version": "1.0",
    "description": "Checks the current website for phishing using hybrid ML analysis",
    "permissions": [
        "activeTab"
    ],
    "host_permissions": [
        "http://localhost:8000/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Check this page for phishing"
    },
    "background": {
        "service_worker": "background.js"
    }
}